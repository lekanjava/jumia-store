@"
# Virtual environments
venv/*
.venv/*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Database files - NEVER commit these
*.db
*.sqlite
*.sqlite3

# Environment variables - NEVER commit these
.env
.env.*
*.env

# uv
.python-version

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Logs
*.log
logs/

# Test artifacts
.coverage
htmlcov/
.pytest_cache/
"@ | Set-Content .gitignore
